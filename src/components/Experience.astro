---
import SectionHeading from './SectionHeading.astro';
import { l, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { work, education, spokenLanguages, type TimelineEntry } from '../data/experience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const columns: { title: string; entries: TimelineEntry[] }[] = [
  { title: t('experience.education'), entries: education },
  { title: t('experience.work'), entries: work },
];
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading
      id="experience-title"
      kicker={t('experience.kicker')}
      title={t('experience.title')}
    />

    <div class="columns">
      {columns.map((col) => (
        <div>
          <h3 class="col-title mono">{col.title}</h3>
          <ol class="timeline">
            {col.entries.map((e) => (
              <li>
                <p class="period mono">{e.period}</p>
                <h4>{l(e.title, lang)}</h4>
                <p class="org">{l(e.org, lang)}</p>
                {e.note && <p class="note">{l(e.note, lang)}</p>}
                {e.details && (
                  <ul class="details">
                    {l(e.details, lang).map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>

    <div class="languages">
      <h3 class="col-title mono">{t('experience.languages')}</h3>
      <ul>
        {spokenLanguages.map((sl) => (
          <li>
            <strong>{l(sl.name, lang)}</strong>
            <span class="mono">{l(sl.level, lang)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 4rem);
  }

  .col-title {
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border-strong);
  }

  .timeline > li {
    position: relative;
    padding: 0 0 2rem 1.5rem;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45rem;
    width: 9px;
    height: 9px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .period {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  h4 {
    margin-top: 0.3rem;
    font-size: 1.15rem;
  }

  .org {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .note {
    margin-top: 0.6rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-size: 0.93rem;
  }

  .details {
    margin-top: 0.6rem;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .details li + li {
    margin-top: 0.25rem;
  }

  .languages {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .languages ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .languages li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .languages span {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 799px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
