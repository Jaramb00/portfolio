---
import SectionHeading from './SectionHeading.astro';
import { l, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { approach } from '../data/approach';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="container">
    <SectionHeading id="approach-title" kicker={t('approach.kicker')} title={t('approach.title')} />

    <ol class="steps">
      {approach.map((item, i) => (
        <li>
          <span class="num mono" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3>{l(item.title, lang)}</h3>
          <p>{l(item.text, lang)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    border-top: 1px solid var(--border);
  }

  li {
    padding: 1.5rem 1.5rem 0.5rem 0;
  }

  li + li {
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }

  .num {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--accent);
  }

  h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  p {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 1079px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1.5rem;
    }

    li,
    li + li {
      padding: 1.5rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 599px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
