---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import photo from '../assets/photo/thesis-defense-full.jpg';
import { l, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading id="about-title" kicker={t('about.kicker')} title={t('about.title')} />

    <div class="grid">
      <div class="text">
        {l(profile.about, lang).map((p) => (
          <p>{p}</p>
        ))}

        <div class="cards">
          <div class="card">
            <h3 class="mono">{t('about.learning')}</h3>
            <ul>
              {l(profile.learning, lang).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="card">
            <h3 class="mono">{t('about.goals')}</h3>
            <p>{l(profile.goals, lang)}</p>
          </div>
        </div>
      </div>

      <figure class="photo">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 900]}
          sizes="(min-width: 900px) 400px, 90vw"
          alt={t('about.photoAlt')}
        />
        <figcaption>{t('about.caption')}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .text > p + p {
    margin-top: 1.1rem;
  }

  .text > p {
    max-width: 64ch;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .card {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .card h3 {
    margin-bottom: 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card ul {
    padding-left: 1.1rem;
  }

  .card li + li {
    margin-top: 0.35rem;
  }

  .card p,
  .card li {
    font-size: 0.97rem;
    color: var(--text-muted);
  }

  .photo {
    margin: 0;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  .photo :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }

  .photo figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 899px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .photo {
      position: static;
      max-width: 420px;
    }
  }

  @media (max-width: 599px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
